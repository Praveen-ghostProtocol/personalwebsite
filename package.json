{
  "name": "praveen-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "build:public": "node scripts/build.mjs --public",
    "preview:public": "node scripts/serve.mjs --port=4322",
    "build:draft": "node scripts/build.mjs --draft",
    "check": "tsc --noEmit",
    "lint": "eslint src scripts --ignore-pattern audit-sources.py",
    "test": "node --test scripts/*.test.mjs",
    "format": "prettier --write src scripts docs DESIGN.md README.md package.json tsconfig.json eslint.config.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.2.8",
    "@fontsource/instrument-serif": "5.2.8"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3"
  }
}
